# App public URL (no trailing slash) — used for Discord OAuth redirect
APP_URL=http://localhost:3000

# Random secret for signing session cookies (required in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Discord Application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your Discord server (guild) ID
DISCORD_GUILD_ID=

# Comma-separated role IDs — user must have AT LEAST ONE of these
# Right-click role in Discord (Developer Mode on) → Copy Role ID
DISCORD_REQUIRED_ROLE_IDS=
