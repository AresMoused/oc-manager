# App public URL (no trailing slash) — used for Discord OAuth redirect
# Production example: https://oc-manager.vercel.app
APP_URL=http://localhost:3000

# Random secret for signing session cookies (required in production)
AUTH_SECRET=change-me-to-a-long-random-string

# Discord Application (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Your Discord server (guild) ID
DISCORD_GUILD_ID=

# Comma-separated role IDs — user must have AT LEAST ONE of these
DISCORD_REQUIRED_ROLE_IDS=

# ——— Discord bot (slash + 每日公布栏) ———
# Same Application as OAuth. Bot tab → Reset Token / General → Public Key
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Channel for daily prompt, bulletin forwards, and vote results (same channel)
DISCORD_DAILY_CHANNEL_ID=
# Optional override if bulletin should ever split; defaults to DAILY channel
# DISCORD_BULLETIN_CHANNEL_ID=
# Channels to watch for image + #code (comma-separated; can include the daily channel)
DISCORD_WATCH_CHANNEL_IDS=
# Role to @ on daily prompt + daily results (copy role ID; do not hardcode in source)
DISCORD_PING_ROLE_ID=
# Voting emoji on bulletin messages
DISCORD_DAILY_EMOJI=❤️
# Shared secret: Vercel cron/ingest + Railway sidecar
CRON_SECRET=
# Railway sidecar only: where to POST matching messages
INGEST_URL=

# ——— Cloudflare R2 (required on Vercel; optional locally — falls back to ./data) ———
# Cloudflare Dashboard → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=oc-manager

# Public URL for objects (R2 custom domain or *.r2.dev public bucket URL)
# Example: https://media.example.com  OR  https://pub-xxxx.r2.dev
# No trailing slash. Required for uploaded images to display.
R2_PUBLIC_URL=
